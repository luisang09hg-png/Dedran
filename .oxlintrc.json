{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/jsx-a11y/alt-text": "error",
    "react/jsx-a11y/anchor-ambiguous-text": "warn",
    "react/jsx-a11y/anchor-has-content": "error",
    "react/jsx-a11y/aria-props": "error",
    "react/jsx-a11y/aria-proptypes": "error",
    "react/jsx-a11y/aria-role": "error",
    "react/jsx-a11y/aria-unsupported-elements": "error",
    "react/jsx-a11y/heading-has-content": "error",
    "react/jsx-a11y/hyperlink-abstract": "warn",
    "react/jsx-a11y/iframe-sri": "error",
    "react/jsx-a11y/img-redundant-alt": "error",
    "react/jsx-a11y/label-controls": "error",
    "react/jsx-a11y/lang": "warn",
    "react/jsx-a11y/media-has-caption": "warn",
    "react/jsx-a11y/no-access-key": "error",
    "react/jsx-a11y/no-autofocus": "error",
    "react/jsx-a11y/no-distracting-elements": "warn",
    "react/jsx-a11y/no-onchange": "error",
    "react/jsx-a11y/no-redundant-roles": "error",
    "react/jsx-a11y/no-static-element-interactions": "error",
    "react/jsx-a11y/prefer-tag-over-role": "warn"
  }
}
